#include <stdio.h>
#include <stdlib.h>

void dfs(int u, int** graph, int* outDegree, int* visited, int* stack, int* stackIndex) {
    visited[u] = 1;
    for (int i = 0; i < outDegree[u]; i++) {
        int v = graph[u][i];
        if (!visited[v]) {
            dfs(v, graph, outDegree, visited, stack, stackIndex);
        }
    }
    stack[(*stackIndex)++] = u;
}

int main() {
    int numVertices = 6;
    int edges[][2] = {{5, 2}, {5, 0}, {4, 0}, {4, 1}, {2, 3}, {3, 1}};
    int numEdges = 6;

    int* outDegree = (int*)calloc(numVertices, sizeof(int));
    for (int i = 0; i < numEdges; i++) {
        outDegree[edges[i][0]]++;
    }

    int** graph = (int**)malloc(numVertices * sizeof(int*));
    for (int i = 0; i < numVertices; i++) {
        graph[i] = (int*)malloc(outDegree[i] * sizeof(int));
        outDegree[i] = 0; 
    }

    for (int i = 0; i < numEdges; i++) {
        int u = edges[i][0];
        int v = edges[i][1];
        graph[u][outDegree[u]++] = v;
    }

    int* visited = (int*)calloc(numVertices, sizeof(int));
    int* stack = (int*)malloc(numVertices * sizeof(int));
    int stackIndex = 0;

    for (int i = 0; i < numVertices; i++) {
        if (!visited[i]) {
            dfs(i, graph, outDegree, visited, stack, &stackIndex);
        }
    }

    for (int i = stackIndex - 1; i >= 0; i--) {
        printf("%d ", stack[i]);
    }
    printf("\n");

    for (int i = 0; i < numVertices; i++) {
        free(graph[i]);
    }
    free(graph);
    free(outDegree);
    free(visited);
    free(stack);

    return 0;
}
