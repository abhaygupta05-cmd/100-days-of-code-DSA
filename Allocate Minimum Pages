#include <stdio.h>

int isPossible(int arr[], int n, int m, int maxPages) {
    int studentCount = 1;
    int currentPages = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] > maxPages) return 0;

        if (currentPages + arr[i] > maxPages) {
            studentCount++;
            currentPages = arr[i];
            
            if (studentCount > m) return 0;
        } else {
            currentPages += arr[i];
        }
    }
    return 1;
}

int main() {
    int n, m;
    if (scanf("%d %d", &n, &m) != 2) return 0;

    int arr[n];
    int maxVal = 0;
    long long sumVal = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] > maxVal) maxVal = arr[i];
        sumVal += arr[i];
    }

    if (m > n) {
        printf("-1\n");
        return 0;
    }

    int low = maxVal;
    int high = (int)sumVal;
    int ans = high;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (isPossible(arr, n, m, mid)) {
            ans = mid;      // Try to find a smaller maximum
            high = mid - 1;
        } else {
            low = mid + 1;  // Increase the limit
        }
    }

    printf("%d\n", ans);

    return 0;
}
