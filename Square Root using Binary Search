#include <stdio.h>

long long findIntegerSqrt(long long n) {
    if (n < 2) {
        return n;
    }

    long long low = 0;
    long long high = n / 2;
    long long ans = 0;

    while (low <= high) {
        long long mid = low + (high - low) / 2;
        
        // We use mid <= n/mid to prevent overflow of mid * mid
        if (mid <= n / mid) {
            ans = mid;      // mid is a potential square root
            low = mid + 1;  // Try finding a larger value in the right half
        } else {
            high = mid - 1; // mid * mid is too large, search in the left half
        }
    }

    return ans;
}

int main() {
    long long n;

    // Read the input number
    if (scanf("%lld", &n) != 1) {
        return 0;
    }

    // Special case for n = 1
    if (n == 1) {
        printf("1\n");
        return 0;
    }

    printf("%lld\n", findIntegerSqrt(n));

    return 0;
}
